{
  // The commands a run needs, as tasks, so driving a stage is a pick from the Run Task menu rather than a
  // line composed by hand. S3: the "one keystroke" the target process rests on did not exist —
  // `ls -a .vscode/` returned `settings.json` and nothing else.
  //
  // **This file used to say the agent on this surface holds no terminal.** That was never true: VS Code
  // core registers `runInTerminal` and `runTask`, and the catalogue missed both because the scan looked
  // for a literal string where those two name themselves through a variable. What is true is that no
  // wrapper grants a terminal, which is a choice.
  //
  // **This block claimed the producing agents were granted `runTask`, and not one of them was, from the
  // day it was written until 31 August 2026.** Every wrapper carried `readFile`, `createFile` and
  // `editFiles`, so the sentence describing how the workflow drives itself described nothing on disk.
  // **Since 31 August the four producing agents hold `runTask` and `getTaskOutput`.** The Product Manager
  // was granted them first, alone, as a probe; a live Copilot session then observed the name resolving,
  // the terminal opening and the agent reading the output back in the same turn, and the other three
  // followed. That grant runs only what this file declares and nothing else, so it drives the workflow
  // without any agent gaining the ability to run an arbitrary command.
  //
  // **Material Intake is deliberately not among them.** Its grant is reading a file and writing one, and
  // widening it is a decision about the quarantine boundary rather than a step in rolling this out.
  //
  // **A task carrying an `${input:...}` is one no agent can complete**, observed live on 31 August: the
  // box goes in front of the person, the agent cannot fill it, and the agent's turn ends there with the
  // task's output unrecoverable afterwards. That is the mechanism an acceptance rests on and the reason
  // every task the workflow triggers for itself takes no input. `.github/OPERATING-A-RUN.md` is the page that says which one to run when, and it is
  // generated from the same registers these commands come from.
  //
  // Every task prompts for what it needs. Nothing here hardcodes a run id or a runs root: the root is one
  // line in `.github/runs-root` and the tasks read it, so repointing the root moves every task with it.
  //
  // **What a person types into a box reaches the script through the environment, never through the command
  // line.** A shell reads the command line first, so a quote typed into a box was removed, a `$` expanded and a
  // pair of backticks run as a command. VS Code puts each `options.env` value into the task's environment as it
  // was typed, and `task.mjs` hands `SPOCK_BOX_<id>` to the script where the command says `box:<id>`. The `env`
  // entries follow the order of the `box:` words, because that is the order the boxes open in. The run is
  // `run:id`, `run:dir` or `run:stage`, never a word starting with `@`, which PowerShell drops before the script.
  //
  // Each task also names itself in `SPOCK_TASK`, so its output can say which task ran and which boxes it opened; C179
  // holds the name to the label.
  "version": "2.0.0",
  "inputs": [
    {
      "id": "runId",
      "type": "promptString",
      "description": "The run id: the year, the month and a short name, in lower case, as in 2026-10-card-freeze"
    },
    {
      "id": "personName",
      "type": "promptString",
      "description": "Your name, as in Petra Nováková. The run records you as the person running it"
    },
    {
      "id": "personRole",
      "type": "promptString",
      "description": "The role you decide in, as in Product Manager. It is filled in from here on, wherever a task asks your role"
    },
    {
      "id": "jiraKey",
      "type": "promptString",
      "description": "The initiative's Jira key, as in PROJ-1234, or none yet if it has no key yet"
    },
    {
      "id": "stage",
      "type": "pickString",
      "description": "Which stage",
      "options": ["1", "2", "3", "4", "5", "6", "7"]
    },
    {
      "id": "status",
      "type": "pickString",
      "description": "The stage's new status",
      "options": ["running", "produced"]
    },
    
    {
      "id": "by",
      "type": "promptString",
      "description": "Your name, as in Petra Nováková. The record carries it as the person who decided"
    },
    {
      "id": "keeper",
      "type": "promptString",
      "description": "Your name, as in Petra Nováková. The record carries it as the person keeping this run's market research for later runs; cards built on internal or non-public material stay in the run."
    },
    {
      "id": "approver",
      "type": "promptString",
      "description": "Your name, as in Petra Nováková. You are accepting this stage, and the record will say so"
    },
    {
      // **`exception` is on the list for the replace task, where it withdraws one sign-off** (21 September 2026). The
      // record task shares the list; `exception` chosen there is refused and the refusal names both tasks.
      "id": "decisionKind",
      "type": "pickString",
      "description": "What kind of decision this is. exception is for withdrawing a sign-off with 'SPOCK: replace a decision that no longer stands'; a check is signed off with 'SPOCK: sign off a check this run cannot meet'",
      "options": ["choice", "direction", "exception"]
    },
    {
      "id": "what",
      "type": "promptString",
      "description": "What was decided, in your own words, as in: we go ahead without this and ask the analytics team for the figure before the PRD. The record carries it beside the check you sign off"
    },
    {
      "id": "decisionWhy",
      "type": "promptString",
      "description": "Why did you decide this, in your own words? For a choice, why that one, as in: SOL2 reaches the clients who leave at the second step, and SOL1 does not. For a direction, what you changed and why"
    },
    {
      // The replace task's own words box. It asks why, in the words of the box above, because a replacement choice's
      // words become the reason the selected-solution document carries.
      "id": "replaceWhy",
      "type": "promptString",
      "description": "Why did you decide this, in your own words? For a choice, why that one, as in: SOL2 reaches the clients who leave at the second step, and SOL1 does not. For a direction, what you changed and why"
    },
    {
      "id": "role",
      "type": "promptString",
      "description": "The role you decided in, as in Product Manager. Leave it empty to keep the role this run records for your name"
    },
    {
      "id": "refineReason",
      "type": "promptString",
      "description": "Why it was sent back, in your own words, as in: the opportunities rest on one interview, and the survey arrived today"
    },
    {
      "id": "keepWhy",
      "type": "promptString",
      "description": "Why the stage still stands as it is, in your own words, as in: the new brief changed the title only, and nothing stage 3 found depends on it"
    },
    {
      "id": "stopReason",
      "type": "pickString",
      "description": "Why the run stops. low_value: the value does not justify the work. small_impact: the impact is too small to pursue. high_risk: the risk is not worth carrying. out_of_boundary: it belongs to another team or product.",
      "options": ["low_value", "small_impact", "high_risk", "out_of_boundary"]
    },
    {
      "id": "stopNote",
      "type": "promptString",
      "description": "Anything the record should say beyond the reason, in your own words. Leave it empty if the reason says it all."
    },
    {
      "id": "supersedesAt",
      "type": "promptString",
      "description": "The date of the decision this one replaces, as the run shows it, as in 24. 9. 2026"
    },
    {
      "id": "supersedeReason",
      "type": "promptString",
      "description": "Why the earlier decision no longer stands, in your own words, as in: the pilot budget moved to next year, so the smaller option stands"
    },
    {
      "id": "stageOwner",
      "type": "promptString",
      "description": "The name of the person who is doing this stage's work, as in Tomáš Havlíček, when that is not the person who will accept it"
    },
    {
      "id": "selection",
      "type": "promptString",
      "description": "The id of the one you chose, as the document shows it, as in SOL2. Leave it empty unless this is a decision of kind choice. A value that is not one of them is refused and the refusal lists them.",
      "default": ""
    },
    {
      "id": "stageOwnerRole",
      "type": "promptString",
      "description": "The role that person is doing the work in, as in Researcher. Leave it empty to keep the role this run records for that name"
    },
    {
      // ── r1.11 · J-d7 §5.1 ── box 3 of the approval, where it was box 4 of a task of its own that nobody ran.
      "id": "judgedVerdicts",
      "type": "promptString",
      "description": "Your answers to the questions this gate asks you, which the agent listed: y for yes, n for no, ? if you cannot tell, numbered as in 1y 2n. Optional: leave it empty to skip them, or leave a number out to skip that question. A skipped question is recorded as skipped. Leave it empty where this gate asks none."
    },
    {
      // ── r1.11 · Z5 D5 ── the take-in's confirmation, on both tasks that take in supplied material: an agent that starts a
      // task with a box is refused by the step guard, so what changed is taken in only on the person's word.
      "id": "takeInChanges",
      "type": "pickString",
      "description": "Take in the supplied material the agent listed as new or changed? yes records all of it at once, no records nothing",
      "options": ["yes", "no"]
    },
    {
      // ── r1.11 · R3 §5.3 ── box 4 of the approval: the person's own words, empty allowed.
      "id": "askedBefore",
      "type": "promptString",
      "description": "What you asked to be changed before approving, in your own words. Correct my list or leave it empty."
    },
    {
      "id": "exceptionCheck",
      "type": "promptString",
      "description": "Which automated check(s) this run cannot meet, by number, as the gate reported them, as in C60, or C11,C12,C171 where one cause failed several"
    },
    {
      "id": "exceptionReason",
      "type": "promptString",
      "description": "Why it cannot be met, in your own words, as in: no source publishes this figure for our market, so the document cannot cite one. Not that it was not met: why it cannot be"
    },
    {
      // **What a sign-off says its failure points to** (Z31, 21 September 2026). The workflow is listed first, because
      // Enter picks the first item, and a false workflow report costs a minute of triage where a false material report
      // hides a fault in the workflow. The sign-off records the key, `workflow` or `material`.
      "id": "exceptionCause",
      "type": "pickString",
      "description": "What the failure points to. The first if you think the workflow or the check is at fault rather than your material; the second if your material cannot give the check what it asks",
      "options": ["the workflow looks wrong", "the material cannot meet it"]
    },
    {
      "id": "withdrawFile",
      "type": "promptString",
      "description": "The file to take back, as in 2-opportunities/opportunities copy.md, as the agent names it from a check or as you choose it. A folder is listed, and taken back when you type it again with the count the listing printed. Leave it empty to take back what the checks report joined to nothing",
      "default": ""
    },
    {
      "id": "withdrawReason",
      "type": "promptString",
      "description": "Why it is not part of the run any more, in words a reader would understand, as in: a draft copy of the framed opportunities, kept by mistake"
    },
    {
      "id": "editDocument",
      "type": "promptString",
      "description": "The document you changed, by its path inside the run, as in 1-brief/initiative-brief.md"
    },
    {
      "id": "editWhat",
      "type": "promptString",
      "description": "What you changed, in your own words, as in: shortened the outcome to one sentence"
    },
    {
      "id": "editWhy",
      "type": "promptString",
      "description": "Why you changed it, in your own words, as in: the committee reads only the first line"
    },
    {
      "id": "editBy",
      "type": "promptString",
      "description": "Your name, as in Petra Nováková. The account of the change is recorded under it"
    },
    {
      "id": "typedProblem",
      "type": "promptString",
      "description": "The problem, in your own words. It is saved exactly as you type it and added to the problem material"
    },
    // ── r1.11 · BC-25 ── the two boxes of "SPOCK: date the material that arrived without dates". A box cannot be filled
    // by a script, so the first holds "as listed", which stands for the periods the read-in listed.
    {
      "id": "periods",
      "type": "promptString",
      "description": "The period each file without dates comes from, as the task output listed them, as in: as listed; tickets.csv: 2026-Q2. \"as listed\" takes the listed periods as they stand; correct or complete a file by adding file: period after a semicolon. A period is a year, a quarter or a month: 2026, 2026-Q2 or 2026-04. A file left without a period stays undated",
      "default": "as listed"
    },
    {
      "id": "periodsBy",
      "type": "promptString",
      "description": "Your name, as in Petra Nováková. The periods are recorded as your statement, under this name"
    },
    {
      "id": "pastedBy",
      "type": "promptString",
      "description": "Your name, as in Petra Nováková. What you pasted is saved exactly as it is and recorded as yours, under this name"
    },
    {
      "id": "traceFile",
      "type": "promptString",
      "description": "Path to the raw Copilot trace file, as in .copilot-traces/otel.jsonl — customer material from its first line",
      "default": ".copilot-traces/otel.jsonl"
    },
    // ── r1.4 P6 · Z38 ── The four boxes of "SPOCK: correct a name on the record", after the stage pick list.
    {
      "id": "nameAsRecorded",
      "type": "promptString",
      "description": "The name as the record spells it now, as in Tomas Havlicek, exactly as the heads-up or the run's front page shows it"
    },
    {
      "id": "nameCorrected",
      "type": "promptString",
      "description": "The name as it should be spelled, as in Tomáš Havlíček"
    },
    {
      "id": "correctedBy",
      "type": "promptString",
      "description": "Your name, as in Petra Nováková. The record will say you made this correction"
    },
    {
      "id": "correctWhy",
      "type": "promptString",
      "description": "Why the recorded spelling is wrong, in your own words, as in: the record spells my surname without its accents"
    },
    // ── r1.9 H15 ── The one box of "SPOCK: update this copy to the latest release". Until the box table of H13 takes it in,
    // this description is its only declaration and carries its example, update.
    {
      "id": "updateHow",
      "type": "pickString",
      "description": "Pick update. Pick the second only if this task told you files of the workflow were changed on this computer: it keeps a copy of them and puts the release's back",
      "options": ["update", "update, and set aside my changes to the workflow's own files"],
      "default": "update"
    },
    // ── r1.11 BC-49 ── The one box of "SPOCK: check my setup": the tool a person uses SPOCK in, which the check saves in
    // .github/surface in the form a run reads, so nobody edits that file by hand.
    {
      "id": "setupTool",
      "type": "pickString",
      "description": "Which tool you use SPOCK in",
      "options": ["GitHub Copilot", "another agent tool"],
      "default": "GitHub Copilot"
    }
  ],
  "tasks": [
    {
      // **A decision that no longer stands is replaced, never deleted.** `C168` refuses a recorded choice
      // older than the artifact it decided, which is the 6 September case: a run carried a selection made
      // about a set that had since been superseded, and every check passed over it. Clearing it used to
      // mean hand-editing `RUN-STATE.md`, the one file whose own header says agents do not write it.
      "label": "SPOCK: replace a decision that no longer stands",
      "type": "shell",
      "command": "node .github/scripts/task.mjs run-state.mjs decide run:id box:stage --kind box:decisionKind --selection box:selection --what box:replaceWhy --by box:by --role box:role --supersedes box:supersedesAt --reason box:supersedeReason :: advance.mjs --waits",
      "options": {
        "env": {
          "SPOCK_TASK": "SPOCK: replace a decision that no longer stands",
          "SPOCK_BOX_stage": "${input:stage}",
          "SPOCK_BOX_decisionKind": "${input:decisionKind}",
          "SPOCK_BOX_selection": "${input:selection}",
          "SPOCK_BOX_replaceWhy": "${input:replaceWhy}",
          "SPOCK_BOX_by": "${input:by}",
          "SPOCK_BOX_role": "${input:role}",
          "SPOCK_BOX_supersedesAt": "${input:supersedesAt}",
          "SPOCK_BOX_supersedeReason": "${input:supersedeReason}"
        }
      },
      "detail": "Records a new decision and marks the earlier one superseded, with the reason. Both stay on the record: nothing about who decided what is lost. With kind exception it withdraws the sign-off dated in the date box and records nothing new; the selection box is not read. It ends by saying what the stage still waits on.",
      "presentation": { "reveal": "always", "panel": "shared", "close": false },
      "problemMatcher": []
    },
    {
      // ── r1.4 P6 · Z38 ── **A name typed with a slip at an approval could not be corrected.** The approval records
      // it as typed in three places — the stage owner, the gate entry and the decision block on the document — and
      // the heads-up then named a task that reaches the decisions list alone. The only route left was sending the
      // stage back and approving it again, which runs a gate for a spelling. This corrects the spelling and nothing
      // else: both spellings stay, no stage moves, and no gate runs again.
      "label": "SPOCK: correct a name on the record",
      "type": "shell",
      "command": "node .github/scripts/task.mjs run-state.mjs correct-name run:id --from box:nameAsRecorded --to box:nameCorrected --by box:correctedBy --reason box:correctWhy",
      "options": {
        "env": {
          "SPOCK_TASK": "SPOCK: correct a name on the record",
          "SPOCK_BOX_nameAsRecorded": "${input:nameAsRecorded}",
          "SPOCK_BOX_nameCorrected": "${input:nameCorrected}",
          "SPOCK_BOX_correctedBy": "${input:correctedBy}",
          "SPOCK_BOX_correctWhy": "${input:correctWhy}"
        }
      },
      "detail": "Corrects how a person's name is spelled on every stage that carries it, in one run: each stage's owner, its approval and the decisions standing on it, with one line per stage. Both spellings stay on the record, with who corrected it, when and why. Nothing is approved again and no stage moves. FOUR boxes.",
      "presentation": { "reveal": "always", "panel": "shared", "close": false },
      "problemMatcher": []
    },
        // ── The two a discovery user ever needs, and neither asks them anything ──────────────────────────
    //
    // **Every other task here prompts for a run id, a stage number, a status.** That is an operator's
    // vocabulary, and the users are product managers and designers. These two take no input: the run is
    // the one that is unfinished, the stage is the one that is not accepted, and what was produced is
    // read off the disk against the workflow contract.
    //
    // Parameterless for a second reason. **An agent can run a task and cannot answer a prompt**, so a
    // task carrying an input is one the workflow can never run for itself.
    {
      "label": "SPOCK: continue",
      "type": "shell",
      "command": "node .github/scripts/task.mjs advance.mjs",
      "options": { "env": { "SPOCK_TASK": "SPOCK: continue" } },
      "detail": "Does everything mechanical up to the next point where you have to decide something.",
      "problemMatcher": []
    },
    {
      "label": "SPOCK: approve what is in front of me",
      "type": "shell",
      "command": "node .github/scripts/task.mjs advance.mjs --approve --by box:approver --role box:role --answers box:judgedVerdicts --asked box:askedBefore",
      "options": {
        "env": {
          "SPOCK_TASK": "SPOCK: approve what is in front of me",
          "SPOCK_BOX_approver": "${input:approver}",
          "SPOCK_BOX_role": "${input:role}",
          "SPOCK_BOX_judgedVerdicts": "${input:judgedVerdicts}",
          "SPOCK_BOX_askedBefore": "${input:askedBefore}"
        }
      },
      "detail": "Your name, the role you accept in, your answers to the gate's questions, and what you asked to be changed before approving, in your own words; the last two are optional and may be left empty. FOUR boxes. At G4 it approves the choice you recorded with 'SPOCK: record a decision I made', and takes the solution from that record. At stage 5 it approves the expansion of the option you recorded with that task. The stage is attributed to you unless somebody else was already recorded as owning it, which 'SPOCK: record who owns this stage' is for. An agent must not start this. The boxes are the record that a person decided, and a producer that reaches for the task has already asked the wrong question.",
      "presentation": { "reveal": "always", "panel": "shared", "close": false },
      "problemMatcher": []
    },
    {
      // **Only for a stage somebody else owns.** The acceptance attributes the stage to whoever signed it
      // and says so out loud, which is right whenever one person does the work and accepts it. D26 wants
      // every stage to name an owner and the bank case is four people across seven stages, so the question
      // still has to be askable — it just stopped being asked of the person who has already answered it.
      // Until 9 September 2026 it was asked at every gate, which cost two boxes on every acceptance and
      // was the second signing defect of the 8 September run.
      //
      // It moves the stage to `running`, so it belongs at the START of a stage. Run against a stage that
      // has already produced something it would cascade the stages after it as stale, which is the right
      // behaviour for a re-run and the wrong one for naming a person.
      "label": "SPOCK: record who owns this stage",
      "type": "shell",
      "command": "node .github/scripts/task.mjs run-state.mjs stage run:id run:stage running --owner box:stageOwner --role box:stageOwnerRole",
      "options": {
        "env": {
          "SPOCK_TASK": "SPOCK: record who owns this stage",
          "SPOCK_BOX_stageOwner": "${input:stageOwner}",
          "SPOCK_BOX_stageOwnerRole": "${input:stageOwnerRole}"
        }
      },
      "detail": "At the START of a stage, and only when the person doing the work is not the person who will accept it. Otherwise skip it: the acceptance attributes the stage to whoever signs it.",
      "presentation": { "reveal": "always", "panel": "shared", "close": false },
      "problemMatcher": []
    },
    {
      "label": "SPOCK: start a run",
      "type": "shell",
      "command": "node .github/scripts/task.mjs run-state.mjs init box:runId --person box:personName --role box:personRole",
      "options": {
        "env": {
          "SPOCK_TASK": "SPOCK: start a run",
          "SPOCK_BOX_runId": "${input:runId}",
          "SPOCK_BOX_personName": "${input:personName}",
          "SPOCK_BOX_personRole": "${input:personRole}"
        }
      },
      "detail": "Creates the whole tree, the run record and the front page, and records you as the person running it, in your role. Your role is filled in from here on, wherever a task asks it.",
      "presentation": { "reveal": "always", "panel": "shared", "close": false },
      "problemMatcher": []
    },
    {
      // **A move a person asks for is never a way round a gate or the send-back.** Moving a stage to review or to
      // accepted skipped the gate and the approval, and moving an accepted stage back to running left its signatures
      // standing over documents being redone, so the redo's gate could not pass. The status box offers neither review
      // nor accepted, and `--person` makes the writer refuse the move of an accepted stage and name the send-back. The
      // edge stays open to scripts, which do not pass the flag.
      "label": "SPOCK: move a stage",
      "type": "shell",
      "command": "node .github/scripts/task.mjs run-state.mjs stage run:id box:stage box:status --person",
      "options": {
        "env": {
          "SPOCK_TASK": "SPOCK: move a stage",
          "SPOCK_BOX_stage": "${input:stage}",
          "SPOCK_BOX_status": "${input:status}"
        }
      },
      "detail": "Moves a stage to running or to produced. It never puts a stage up for review or accepts one: the gate and the approval do that. A stage already accepted is redone with 'SPOCK: send a stage back to be redone'.",
      "presentation": { "reveal": "always", "panel": "shared", "close": false },
      "problemMatcher": []
    },
    {
      "label": "SPOCK: run one gate",
      "type": "shell",
      "command": "node .github/scripts/task.mjs check.mjs --gate",
      "options": { "env": { "SPOCK_TASK": "SPOCK: run one gate" } },
      "detail": "The gate of the stage the run is on. pass, fail or incomplete. Incomplete is not a pass. Takes nothing: the run and the gate are both things the build already knows.",
      "problemMatcher": []
    },
    // **What a failing check wants, printed beside the lines that failed.** An agent whose document failed the same check
    // twice went and read the checker, where the check register and the stage's shapes body already said it. It opens
    // no box, because a boxed task is the person's to run and it is the agent that needs this; the gate says which
    // checks fail, so it explains every one of them.
    {
      "label": "SPOCK: explain what the gate failed",
      "type": "shell",
      "command": "node .github/scripts/task.mjs explain.mjs",
      "options": { "env": { "SPOCK_TASK": "SPOCK: explain what the gate failed" } },
      "detail": "For each check the gate of the stage the run is on fails now: what failed, what the check is for, from .github/COVERAGE-CHECKS.md, and the shape that passes, from the stage's shapes body where it has one. Runs the gate and records nothing. Takes nothing.",
      "problemMatcher": []
    },
    {
      // **The missing half of the re-run edge.** Putting an accepted stage back to `running` left the gate
      // result, the signature and the decisions behind it, and raised a stale cascade against the stage's
      // own outputs that C30 then demanded a human acceptance of. Resetting stage 4 that way on
      // 7 September 2026 produced a run the checker refused three ways.
      "label": "SPOCK: send a stage back to be redone",
      "type": "shell",
      "command": "node .github/scripts/task.mjs run-state.mjs retract run:id box:stage --by box:by --reason box:refineReason --role box:role",
      "options": {
        "env": {
          "SPOCK_TASK": "SPOCK: send a stage back to be redone",
          "SPOCK_BOX_stage": "${input:stage}",
          "SPOCK_BOX_by": "${input:by}",
          "SPOCK_BOX_refineReason": "${input:refineReason}",
